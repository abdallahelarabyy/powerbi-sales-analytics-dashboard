expression DataFolder = "F:\Data Analysis\Digital Hub\Mid Term\Project\Data\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 466ea106-6029-4f62-94f2-b5a81dc3efd6

	annotation PBI_ResultType = Text

expression CleanSpaces =
		(t as nullable text) as nullable text =>
		    if t = null then null else Text.Combine(List.Select(Text.Split(Text.Trim(t), " "), each _ <> ""), " ")
	lineageTag: 086a9265-86bd-4c2d-bb3b-f247e23f4921

	annotation PBI_ResultType = Function

expression CityKeyMap =
		let
		    Source = Csv.Document(File.Contents(DataFolder & "DimCity.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"City Key", Int64.Type}, {"City", type text}, {"State Province", type text}}, "en-US"),
		    #"Trimmed Text" = Table.TransformColumns(#"Changed Type", {{"City", Text.Trim, type text}, {"State Province", Text.Trim, type text}}),
		    #"Keys Per City" = Table.Group(#"Trimmed Text", {"City", "State Province"}, {{"City Key", each [City Key], type list}}),
		    #"Added City ID" = Table.AddColumn(#"Keys Per City", "City ID", each List.Min([City Key]), Int64.Type),
		    #"One Row Per Old Key" = Table.ExpandListColumn(#"Added City ID", "City Key"),
		    #"Kept Key Columns" = Table.TransformColumnTypes(Table.SelectColumns(#"One Row Per Old Key", {"City Key", "City ID"}), {{"City Key", Int64.Type}})
		in
		    #"Kept Key Columns"
	lineageTag: 994f731a-b46e-4750-8ab9-78b84f53e77a

	annotation PBI_ResultType = Table

expression EmployeeKeyMap =
		let
		    Source = Excel.Workbook(File.Contents(DataFolder & "DimEmployee.xlsx"), null, true),
		    Sheet = Source{[Item = "DimEmployee", Kind = "Sheet"]}[Data],
		    #"Promoted Headers" = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
		    #"Kept Key Columns" = Table.SelectColumns(#"Promoted Headers", {"Employee Key", "WWI Employee ID"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Kept Key Columns", {{"Employee Key", Int64.Type}, {"WWI Employee ID", Int64.Type}}),
		    #"Renamed Columns" = Table.RenameColumns(#"Changed Type", {{"WWI Employee ID", "Employee ID"}})
		in
		    #"Renamed Columns"
	lineageTag: 8bf3dc0f-a593-4846-8e36-fa0f03ab1de4

	annotation PBI_ResultType = Table

