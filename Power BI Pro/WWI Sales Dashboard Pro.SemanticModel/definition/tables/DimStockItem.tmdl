	partition DimStockItem = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DimStockItem.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Removed Junk First Row" = Table.Skip(Source, 1),
				    #"Promoted Headers" = Table.PromoteHeaders(#"Removed Junk First Row", [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Stock Item Key", Int64.Type}, {"WWI Stock Item ID", Int64.Type}, {"Stock Item", type text}, {"Color", type text}, {"Selling Package", type text}, {"Buying Package", type text}, {"Brand", type text}, {"Size", type text}, {"Lead Time Days", Int64.Type}, {"Quantity Per Outer", Int64.Type}, {"Is Chiller Stock", Int64.Type}, {"Unit Price", type number}, {"Recommended Retail Price", type text}, {"Typical Weight Per Unit", type number}}, "en-US"),
				    #"Kept One Row Per Product" = Table.SelectRows(#"Changed Type", each [Stock Item Key] <= 227),
				    #"Removed Broken Columns" = Table.RemoveColumns(#"Kept One Row Per Product", {"Tax Rate", "Barcode", "Photo", "Discount", "Valid From", "Valid To", "Lineage Key"}),
				    #"Fixed Retail Price" = Table.TransformColumns(#"Removed Broken Columns", {{"Recommended Retail Price", each if _ = null or Text.Trim(_) = "? -" then null else Number.FromText(Text.Remove(_, {"?", " ", ","}), "en-US"), type number}}),
				    #"Color N/A" = Table.ReplaceValue(#"Fixed Retail Price", "N/A", "No Color", Replacer.ReplaceValue, {"Color"}),
				    #"Brand N/A" = Table.ReplaceValue(#"Color N/A", "N/A", "Unbranded", Replacer.ReplaceValue, {"Brand"}),
				    #"Size N/A" = Table.ReplaceValue(#"Brand N/A", "N/A", "No Size", Replacer.ReplaceValue, {"Size"}),
				    #"Package N/A" = Table.ReplaceValue(#"Size N/A", "N/A", "Unknown", Replacer.ReplaceValue, {"Selling Package", "Buying Package"}),
				    #"Trimmed Product Names" = Table.TransformColumns(#"Package N/A", {{"Stock Item", CleanSpaces, type text}}),
				    #"Chiller Yes No" = Table.TransformColumns(#"Trimmed Product Names", {{"Is Chiller Stock", each if _ = 1 then "Yes" else "No", type text}}),
				    #"Added Product Category" = Table.AddColumn(#"Chiller Yes No", "Product Category", each
				        let n = Text.Lower([Stock Item]) in
				        if n = "unknown" then "Unknown"
				        else if Text.StartsWith(n, "usb ") then "USB Novelties"
				        else if Text.Contains(n, "joke mug") then "Novelty Mugs"
				        else if Text.Contains(n, "chocolate") then "Confectionery"
				        else if Text.Contains(n, "slippers") or Text.Contains(n, "socks") then "Slippers & Socks"
				        else if Text.Contains(n, "mask") then "Halloween Masks"
				        else if Text.Contains(n, "hoodie") or Text.Contains(n, "jacket") or Text.Contains(n, "t-shirt") then "Clothing"
				        else if Text.StartsWith(n, "rc ") or Text.StartsWith(n, "ride on") or Text.Contains(n, "action figures") then "Toys"
				        else if Text.Contains(n, "periscope") then "Novelty Gadgets"
				        else if Text.Contains(n, "blade") or Text.Contains(n, "marker") or Text.Contains(n, "knife") then "Office Supplies"
				        else "Packaging Materials", type text),
				    #"Kept Final Columns" = Table.SelectColumns(#"Added Product Category", {"Stock Item Key", "WWI Stock Item ID", "Stock Item", "Product Category", "Color", "Size", "Brand", "Selling Package", "Buying Package", "Is Chiller Stock", "Lead Time Days", "Quantity Per Outer", "Unit Price", "Recommended Retail Price", "Typical Weight Per Unit"})
				in
				    #"Kept Final Columns"

	annotation PBI_ResultType = Table

