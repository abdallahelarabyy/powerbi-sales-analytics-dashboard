	partition DimEmployee = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "DimEmployee.xlsx"), null, true),
				    Sheet = Source{[Item = "DimEmployee", Kind = "Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    #"Removed Empty And System Columns" = Table.RemoveColumns(#"Promoted Headers", {"Photo", "Valid From", "Valid To", "Lineage Key", "Employee Key"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Empty And System Columns", {{"WWI Employee ID", Int64.Type}, {"Employee", type text}, {"Preferred Name", type text}, {"Is Salesperson", Int64.Type}}),
				    #"One Row Per Person" = Table.Distinct(#"Changed Type", {"WWI Employee ID"}),
				    #"Filled Unknown Name" = Table.ReplaceValue(#"One Row Per Person", "N/A", "Unknown", Replacer.ReplaceValue, {"Preferred Name"}),
				    #"Salesperson Yes No" = Table.TransformColumns(#"Filled Unknown Name", {{"Is Salesperson", each if _ = 1 then "Yes" else "No", type text}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Salesperson Yes No", {{"WWI Employee ID", "Employee ID"}}),
				    #"Kept Final Columns" = Table.SelectColumns(#"Renamed Columns", {"Employee ID", "Employee", "Preferred Name", "Is Salesperson"})
				in
				    #"Kept Final Columns"

	annotation PBI_ResultType = Table

