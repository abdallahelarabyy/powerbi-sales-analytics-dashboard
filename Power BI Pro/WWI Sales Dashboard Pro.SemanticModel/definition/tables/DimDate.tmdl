	partition DimDate = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DimDate.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Date", type date}, {"Day Number", Int64.Type}, {"Day", Int64.Type}, {"Month", type text}, {"Short Month", type text}, {"Calendar Month Number", Int64.Type}, {"Calendar Month Label", type text}, {"Calendar Year", Int64.Type}, {"Calendar Year Label", type text}, {"Fiscal Month Number", Int64.Type}, {"Fiscal Month Label", type text}, {"Fiscal Year", Int64.Type}, {"Fiscal Year Label", type text}, {"ISO Week Number", Int64.Type}}, "en-US"),
				    #"Removed Duplicate Day Number" = Table.RemoveColumns(#"Changed Type", {"Day Number"}),
				    #"Added Missing 31 Dec 2016" = Table.InsertRows(#"Removed Duplicate Day Number", Table.RowCount(#"Removed Duplicate Day Number"), {[Date = #date(2016, 12, 31), Day = 31, Month = "December", #"Short Month" = "Dec", #"Calendar Month Number" = 12, #"Calendar Month Label" = "CY2016-Dec", #"Calendar Year" = 2016, #"Calendar Year Label" = "CY2016", #"Fiscal Month Number" = 2, #"Fiscal Month Label" = "FY2017-Dec", #"Fiscal Year" = 2017, #"Fiscal Year Label" = "FY2017", #"ISO Week Number" = 52]}),
				    #"Added Quarter" = Table.AddColumn(#"Added Missing 31 Dec 2016", "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    #"Added Year Quarter" = Table.AddColumn(#"Added Quarter", "Year Quarter", each Text.From([Calendar Year]) & "-" & [Quarter], type text),
				    #"Added Month Year" = Table.AddColumn(#"Added Year Quarter", "Month Year", each [Short Month] & " " & Text.From([Calendar Year]), type text),
				    #"Added Month Year Sort" = Table.AddColumn(#"Added Month Year", "Month Year Sort", each [Calendar Year] * 100 + [Calendar Month Number], Int64.Type),
				    #"Added Weekday" = Table.AddColumn(#"Added Month Year Sort", "Weekday", each Date.DayOfWeekName([Date], "en-US"), type text),
				    #"Added Weekday Number" = Table.AddColumn(#"Added Weekday", "Weekday Number", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    #"Added Is Weekend" = Table.AddColumn(#"Added Weekday Number", "Is Weekend", each if [Weekday Number] >= 6 then "Yes" else "No", type text)
				in
				    #"Added Is Weekend"

