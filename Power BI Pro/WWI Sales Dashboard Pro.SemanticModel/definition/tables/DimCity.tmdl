				    #"One Row Per City" = Table.Group(#"Zero Population To Blank", {"City", "State Province", "Country", "Location"}, {{"City ID", each List.Min([City Key]), Int64.Type}, {"Population", each List.Max([Latest Recorded Population]), Int64.Type}}),
				    #"Added Latitude" = Table.AddColumn(#"One Row Per City", "Latitude", each BinaryFormat.ByteOrder(BinaryFormat.Double, ByteOrder.LittleEndian)(Binary.Range(Binary.FromText(Text.AfterDelimiter([Location], "0x"), BinaryEncoding.Hex), 6, 8)), type number),
				    #"Added Longitude" = Table.AddColumn(#"Added Latitude", "Longitude", each BinaryFormat.ByteOrder(BinaryFormat.Double, ByteOrder.LittleEndian)(Binary.Range(Binary.FromText(Text.AfterDelimiter([Location], "0x"), BinaryEncoding.Hex), 14, 8)), type number),
