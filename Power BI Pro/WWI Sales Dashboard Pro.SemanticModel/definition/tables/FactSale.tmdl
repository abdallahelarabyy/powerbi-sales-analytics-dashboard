	partition FactSale = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactSale.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"NULL Delivery To Blank" = Table.ReplaceValue(#"Promoted Headers", "NULL", null, Replacer.ReplaceValue, {"Delivery Date Key"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"NULL Delivery To Blank", {{"Sale Key", Int64.Type}, {"City Key", Int64.Type}, {"Customer Key", Int64.Type}, {"Bill To Customer Key", Int64.Type}, {"Stock Item Key", Int64.Type}, {"Invoice Date Key", type date}, {"Delivery Date Key", type date}, {"Salesperson Key", Int64.Type}, {"WWI Invoice ID", Int64.Type}, {"Description", type text}, {"Package", type text}, {"Quantity", Int64.Type}, {"Unit Price", type number}, {"Tax Rate", Int64.Type}, {"Total Excluding Tax", type number}, {"Tax Amount", type number}, {"Profit", type number}, {"Total Including Tax", type number}, {"Total Dry Items", Int64.Type}, {"Total Chiller Items", Int64.Type}}, "en-US"),
				    #"Removed Lineage Key" = Table.RemoveColumns(#"Changed Type", {"Lineage Key"}),
				    #"Renamed Dates" = Table.RenameColumns(#"Removed Lineage Key", {{"Invoice Date Key", "Invoice Date"}, {"Delivery Date Key", "Delivery Date"}}),
				    #"Added Delivery Status" = Table.AddColumn(#"Renamed Dates", "Delivery Status", each if [Delivery Date] = null then "Pending" else "Delivered", type text),
				    #"Trimmed Descriptions" = Table.TransformColumns(#"Added Delivery Status", {{"Description", CleanSpaces, type text}}),
				    #"Merged City Map" = Table.NestedJoin(#"Trimmed Descriptions", {"City Key"}, CityKeyMap, {"City Key"}, "City Map", JoinKind.LeftOuter),
				    #"Added City ID" = Table.ExpandTableColumn(#"Merged City Map", "City Map", {"City ID"}, {"City ID"}),
				    #"Merged Employee Map" = Table.NestedJoin(#"Added City ID", {"Salesperson Key"}, EmployeeKeyMap, {"Employee Key"}, "Employee Map", JoinKind.LeftOuter),
				    #"Added Salesperson ID" = Table.ExpandTableColumn(#"Merged Employee Map", "Employee Map", {"Employee ID"}, {"Salesperson ID"}),
				    #"Merged Product List Price" = Table.NestedJoin(#"Added Salesperson ID", {"Stock Item Key"}, DimStockItem, {"Stock Item Key"}, "Product", JoinKind.LeftOuter),
				    #"Added List Unit Price" = Table.ExpandTableColumn(#"Merged Product List Price", "Product", {"Unit Price"}, {"List Unit Price"}),
				    #"Added Discount %" = Table.AddColumn(#"Added List Unit Price", "Discount %", each if [List Unit Price] = null or [List Unit Price] = 0 then 0 else Number.Round(1 - [Unit Price] / [List Unit Price], 4), type number),
				    #"Added Price Type" = Table.AddColumn(#"Added Discount %", "Price Type", each if [#"Discount %"] > 0 then "Promotional" else "List Price", type text),
				    #"Added Cost" = Table.AddColumn(#"Added Price Type", "Cost", each Number.Round([Total Excluding Tax] - [Profit], 2), type number),
				    #"Added Profit Margin" = Table.AddColumn(#"Added Cost", "Profit Margin", each if [Total Excluding Tax] = 0 then null else Number.Round([Profit] / [Total Excluding Tax], 4), type number),
				    #"Added Is Loss" = Table.AddColumn(#"Added Profit Margin", "Is Loss", each if [Profit] < 0 then "Yes" else "No", type text),
				    Quartiles = List.Percentile(#"Added Is Loss"[Quantity], {0.25, 0.75}, [PercentileMode = PercentileMode.ExcelInc]),
				    BulkFence = Quartiles{1} + 1.5 * (Quartiles{1} - Quartiles{0}),
				    #"Added Bulk Order" = Table.AddColumn(#"Added Is Loss", "Bulk Order", each if [Quantity] > BulkFence then "Yes" else "No", type text),
				    #"Kept Final Columns" = Table.SelectColumns(#"Added Bulk Order", {"Sale Key", "WWI Invoice ID", "Invoice Date", "Delivery Date", "Delivery Status", "City Key", "City ID", "Customer Key", "Bill To Customer Key", "Stock Item Key", "Salesperson Key", "Salesperson ID", "Description", "Package", "Quantity", "Unit Price", "List Unit Price", "Discount %", "Price Type", "Tax Rate", "Total Excluding Tax", "Tax Amount", "Total Including Tax", "Cost", "Profit", "Profit Margin", "Is Loss", "Bulk Order", "Total Dry Items", "Total Chiller Items"})
				in
				    #"Kept Final Columns"

	annotation PBI_ResultType = Table

