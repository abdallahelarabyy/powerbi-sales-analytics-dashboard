table FactSale
	lineageTag: 89aac9ac-0fdd-c853-92f6-8af0a3007300

	measure 'Margin Color' = SWITCH ( TRUE (), [Profit Margin] < 0, "#D64545", [Profit Margin] < 0.3, "#F0A202", "#1A7F64" )
		displayFolder: Formatting
		lineageTag: 5238e9c8-459b-367d-ce21-e06bfe77fc13

	measure 'YoY Color' = IF ( [Sales YoY %] < 0, "#D64545", "#1A7F64" )
		displayFolder: Formatting
		lineageTag: a3e263cc-07d1-208a-58d6-8178b1224988

	measure 'Margin Target' = 0.5
		formatString: 0%
		displayFolder: Targets
		lineageTag: 1d75e7ca-9aa7-c051-da51-f747af7db5f9

	measure 'Gauge Max' = 0.8
		formatString: 0%
		displayFolder: Targets
		lineageTag: c5c9fe53-de70-f488-fee9-2828507fa05a

	measure 'Profit per Invoice' = DIVIDE ( [Total Profit], [Invoices] )
		formatString: \$#,0
		displayFolder: Profit
		lineageTag: 9437b767-787c-3ee8-2f74-93a4c4b39c6d

	measure 'Total Sales' = SUM ( FactSale[Total Excluding Tax] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 57bda1f8-536b-e84a-6694-19d1a5feb1bd

	measure 'Total Profit' = SUM ( FactSale[Profit] )
		formatString: \$#,0
		displayFolder: Profit
		lineageTag: 8577e513-1dea-66d2-a112-424733fadc01

	measure 'Profit Margin' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.0%
		displayFolder: Profit
		lineageTag: dd413034-6317-e062-fe27-0e9c15b8e6c4

	measure 'Total Cost' = SUM ( FactSale[Cost] )
		formatString: \$#,0
		displayFolder: Profit
		lineageTag: 22722a40-6284-9c98-fe51-94739d5f2b6e

	measure 'Total Tax' = SUM ( FactSale[Tax Amount] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 0b79bbf9-77a2-3610-1db7-83fd8b750bc2

	measure Invoices = DISTINCTCOUNT ( FactSale[WWI Invoice ID] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 87564a3c-3290-2b1f-2b99-67ad097600a9

	measure 'Units Sold' = SUM ( FactSale[Quantity] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 9a594e65-d0b3-10d7-fd79-1805d272e6df

	measure 'Avg Invoice Value' = DIVIDE ( [Total Sales], [Invoices] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 245e59bb-0986-6994-b263-fabdd81d4bdd

	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( FactSale[Customer Key] ), FactSale[Customer Key] <> 0 )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 9a12ca92-b97d-010c-5f58-e5fce8851b33

	measure 'Cash Sales %' = DIVIDE ( CALCULATE ( [Total Sales], FactSale[Customer Key] = 0 ), [Total Sales] )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 9c8c0f29-0807-8257-3b6e-7497a6fb0318

	measure 'Products Sold' = DISTINCTCOUNT ( FactSale[Stock Item Key] )
		formatString: #,0
		displayFolder: Products
		lineageTag: 96600345-5f00-01d2-e7ae-692eb87095e8

	measure 'Loss from Loss-Making Sales' = - CALCULATE ( SUM ( FactSale[Profit] ), FactSale[Profit] < 0 )
		formatString: \$#,0
		displayFolder: Profit
		lineageTag: 90b27e34-77b8-c154-7c69-c88047c76e16

	measure 'Loss-Making Lines' = CALCULATE ( COUNTROWS ( FactSale ), FactSale[Is Loss] = "Yes" )
		formatString: #,0
		displayFolder: Profit
		lineageTag: d4f436db-0c1e-9fa0-dcaf-6aa4dd2e32cb

	measure 'Sales LY' = VAR LastSaleDate = CALCULATE ( MAX ( FactSale[Invoice Date] ), REMOVEFILTERS () ) RETURN CALCULATE ( [Total Sales], DATEADD ( DimDate[Date], -1, YEAR ), DimDate[Date] <= EDATE ( LastSaleDate, -12 ) )
		formatString: \$#,0
		displayFolder: Time Intelligence
		lineageTag: 0086940c-414e-0d67-4b33-ac9e0a248767

	measure 'Sales YoY %' = IF ( HASONEVALUE ( DimDate[Calendar Year] ), DIVIDE ( [Total Sales] - [Sales LY], [Sales LY] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 5b19aa25-4dd6-db3c-71de-527b2cf450bf

